{
  "name": "sparse-proximity-graph",
  "version": "0.1.0",
  "description": "Build a deterministic, low-degree, approximately planar graph from 2D points.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "SECURITY.md"
  ],
  "scripts": {
    "benchmark": "node benchmark/graph.mjs",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=95",
    "test:types": "tsc -p tsconfig.json",
    "check": "node --check src/index.js && npm run test:types && npm run test:coverage",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "graph",
    "geometry",
    "planar",
    "relative-neighborhood",
    "spatial-index"
  ],
  "engines": {
    "node": ">=22"
  },
  "author": "Sumin Lim <lim@limsumin.com> (https://limsumin.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seoulpro/sparse-proximity-graph.git"
  },
  "bugs": {
    "url": "https://github.com/seoulpro/sparse-proximity-graph/issues"
  },
  "homepage": "https://github.com/seoulpro/sparse-proximity-graph#readme",
  "license": "MIT",
  "devDependencies": {
    "typescript": "~7.0.2"
  }
}
